# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — Resend transactional email (welcome mail, etc.). Server-only.
# Verify a domain in Resend, then set EMAIL_FROM to an address on it. Without a
# key, email sends are skipped silently and never block signup.
RESEND_API_KEY=
EMAIL_FROM=CrewBlocks <onboarding@resend.dev>

# Optional — Bhashini page translation
BHASHINI_SUBSCRIPTION_KEY=

# Optional — Sarvam AI
SARVAM=

# Optional — overrides the canonical site URL used for metadata and OG images
NEXT_PUBLIC_SITE_URL=
